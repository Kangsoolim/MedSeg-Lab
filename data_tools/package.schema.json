{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedSeg-Lab analysis case package 1.0",
  "type": "object",
  "required": [
    "case_id",
    "spatial",
    "methods",
    "has_gt",
    "asset_base",
    "mesh_base",
    "display_modes",
    "generated_at"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "spatial": {
      "type": "object",
      "required": [
        "shape",
        "affine",
        "spacing_mm",
        "unit",
        "axis_codes",
        "slice_centers_ras_mm",
        "slice_positions_mm"
      ],
      "properties": {
        "shape": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "affine": {
          "$ref": "#/$defs/affine"
        },
        "native_affine": {
          "$ref": "#/$defs/affine"
        },
        "spacing_mm": {
          "$ref": "#/$defs/vec3"
        },
        "unit": {
          "const": "mm"
        },
        "axis_codes": {
          "const": [
            "R",
            "A",
            "S"
          ]
        },
        "slice_centers_ras_mm": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec3"
          }
        },
        "slice_positions_mm": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "source",
          "components",
          "analysis",
          "frozen_metrics"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "source": {
            "type": "object"
          },
          "components": {
            "type": "object",
            "required": [
              "connectivity",
              "count",
              "components",
              "labels_path"
            ],
            "properties": {
              "connectivity": {
                "const": 26
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "voxels",
                    "volume_ml",
                    "bbox_ijk",
                    "bbox_ras_mm",
                    "gt_intersection_voxels",
                    "mesh"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "voxels": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "volume_ml": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "gt_intersection_voxels": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "analysis": {
            "type": [
              "object",
              "null"
            ],
            "description": "Null without GT; with GT contains slices, volume and newly computed metrics"
          },
          "frozen_metrics": {
            "type": [
              "object",
              "null"
            ],
            "description": "Original CSV strings, never overwritten by analysis"
          },
          "result_status": {
            "enum": [
              "interactive_experimental",
              "frozen_comparator"
            ]
          },
          "asset_base": {
            "type": "string"
          },
          "mesh_base": {
            "type": "string"
          },
          "computed_pred_volume_ml": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "has_gt": {
      "type": "boolean"
    },
    "gt_mesh": {
      "type": [
        "object",
        "null"
      ]
    },
    "asset_base": {
      "type": "string"
    },
    "mesh_base": {
      "type": "string"
    },
    "display_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string"
    },
    "result_status": {
      "enum": [
        "interactive_experimental"
      ]
    },
    "run_id": {
      "type": "string"
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "affine": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "number"
        }
      }
    }
  }
}
