{
  "schema_version": 1,
  "HistoryImport": {
    "additionalProperties": false,
    "properties": {
      "experiment_id": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
        "title": "Experiment Id",
        "type": "string"
      },
      "format": {
        "enum": [
          "csv",
          "json",
          "jsonl"
        ],
        "title": "Format",
        "type": "string"
      },
      "content": {
        "maxLength": 1000000,
        "minLength": 1,
        "title": "Content",
        "type": "string"
      },
      "source_name": {
        "maxLength": 256,
        "minLength": 1,
        "title": "Source Name",
        "type": "string"
      },
      "mapping": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Mapping",
        "type": "object"
      },
      "metrics": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Metrics",
        "type": "object"
      },
      "definitions": {
        "additionalProperties": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "title": "Definitions",
        "type": "object"
      },
      "metadata": {
        "additionalProperties": true,
        "title": "Metadata",
        "type": "object"
      }
    },
    "required": [
      "experiment_id",
      "format",
      "content",
      "source_name",
      "definitions"
    ],
    "title": "HistoryImport",
    "type": "object"
  },
  "TrainingEvent": {
    "additionalProperties": false,
    "properties": {
      "run_id": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
        "title": "Run Id",
        "type": "string"
      },
      "epoch": {
        "minimum": 0,
        "title": "Epoch",
        "type": "integer"
      },
      "step": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Step"
      },
      "metric_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Metric Name"
      },
      "metric_value": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Metric Value"
      },
      "timestamp": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Timestamp"
      },
      "event_type": {
        "enum": [
          "metric",
          "checkpoint",
          "epoch_end",
          "stopped"
        ],
        "title": "Event Type",
        "type": "string"
      },
      "checkpoint_reference": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Checkpoint Reference"
      }
    },
    "required": [
      "run_id",
      "epoch",
      "event_type"
    ],
    "title": "TrainingEvent",
    "type": "object"
  },
  "LiveTrainingEvent": {
    "additionalProperties": true,
    "description": "v2 envelope; adapter fields extend the common historical event vocabulary.",
    "properties": {
      "schema_version": {
        "const": 2,
        "default": 2,
        "title": "Schema Version",
        "type": "integer"
      },
      "run_id": {
        "pattern": "^[a-f0-9-]{36}$",
        "title": "Run Id",
        "type": "string"
      },
      "sequence": {
        "minimum": 1,
        "title": "Sequence",
        "type": "integer"
      },
      "event_id": {
        "title": "Event Id",
        "type": "string"
      },
      "timestamp": {
        "format": "date-time",
        "title": "Timestamp",
        "type": "string"
      },
      "event_type": {
        "enum": [
          "status",
          "log",
          "batch",
          "metric",
          "checkpoint",
          "epoch_start",
          "epoch_end",
          "validation_end",
          "resumed",
          "terminal"
        ],
        "title": "Event Type",
        "type": "string"
      },
      "epoch": {
        "minimum": 0,
        "title": "Epoch",
        "type": "integer"
      },
      "step": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Step"
      }
    },
    "required": [
      "run_id",
      "sequence",
      "event_id",
      "timestamp",
      "event_type",
      "epoch"
    ],
    "title": "LiveTrainingEvent",
    "type": "object"
  }
}