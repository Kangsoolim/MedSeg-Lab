  "LiveTrainingEvent": {
    "additionalProperties": true,
    "description": "v2 envelope; adapter fields extend the common historical event vocabulary.",
    "properties": {
      "schema_version": {
        "const": 2,
        "default": 2,
        "title": "Schema Version",
        "type": "integer"
      },
      "run_id": {
        "pattern": "^[a-f0-9-]{36}$",
        "title": "Run Id",
        "type": "string"
      },
      "sequence": {
        "minimum": 1,
        "title": "Sequence",
        "type": "integer"
      },
      "event_id": {
        "title": "Event Id",
        "type": "string"
      },
      "timestamp": {
        "format": "date-time",
        "title": "Timestamp",
        "type": "string"
      },
      "event_type": {
        "enum": [
          "status",
          "log",
          "batch",
          "metric",
          "checkpoint",
          "epoch_start",
          "epoch_end",
          "validation_end",
          "resumed",
          "terminal"
        ],
        "title": "Event Type",
        "type": "string"
      },
      "epoch": {
        "minimum": 0,
        "title": "Epoch",
        "type": "integer"
      },
      "step": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Step"
      }
    },
    "required": [
      "run_id",
      "sequence",
      "event_id",
      "timestamp",
      "event_type",
      "epoch"
    ],
    "title": "LiveTrainingEvent",
    "type": "object"
  }
}